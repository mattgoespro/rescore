{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach API Server",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "presentation": {
        "hidden": true
      }
    },
    {
      "name": "Debug Main Process",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "restart": true,
      "preLaunchTask": "Start Rescore debug services",
      "postDebugTask": "Stop Rescore debug services",
      "presentation": {
        "hidden": true
      },
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Renderer Process",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/apps/desktop/src/renderer",
      "timeout": 60000,
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug Rescore",
      "configurations": ["Debug Main Process", "Debug Renderer Process"],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      }
    }
  ]
}
